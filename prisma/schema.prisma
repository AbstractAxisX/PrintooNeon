generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Neon sign design order — simple version (no pricing)
model Order {
  id           String   @id @default(cuid())
  code         String   @unique // short order code like NE-4821
  customerName String
  phone        String
  note         String?

  // neon design spec
  text         String // full text (multi-line with \n)
  fontId       String
  fontName     String
  colorId      String
  colorName    String
  colorId2     String? // gradient mode: second color
  colorName2   String? // gradient mode: second color name
  mode         String   @default("solid") // solid | gradient | flow | perLetter | cycle
  lineMode     String   @default("double") // double (outline tube) | single (text itself is the tube; forced for Arabic script)
  widthCm      Int
  heightCm     Float? // estimated height
  backgroundId String? // wall photo or solid background id
  configJson   String? // full design config JSON (colors, timings, background, letter colors)

  /** ordered list of color ids actually used, in order (JSON array) */
  colorsJson   String?

  imageData    String? // preview image data URL (JPEG or animated GIF)

  status       String   @default("new") // new | contacted | done
  createdAt    DateTime @default(now())
}

/** Single admin account — password hash, changeable from the admin panel.
 *  Seeded from ADMIN_PASSWORD env (or default) on first use. */
model AdminConfig {
  id           Int      @id @default(1)
  passwordHash String
  updatedAt    DateTime @updatedAt
}
