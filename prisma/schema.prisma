generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Neon sign design order — simple version (no pricing, no admin panel)
model Order {
  id           String   @id @default(cuid())
  code         String   @unique // short order code like NE-4821
  customerName String
  phone        String
  note         String?

  // neon design spec
  text         String // full text (multi-line with \n)
  fontId       String
  fontName     String
  colorId      String
  colorName    String
  colorId2     String?
  colorName2   String?
  mode         String   @default("solid") // solid | gradient | duo | rainbow
  widthCm      Int
  heightCm     Float? // estimated height
  wallMode     String? // night | day
  onState      Boolean  @default(true)

  imageData    String? // preview image data URL (JPEG)

  status       String   @default("new") // new | contacted | done
  createdAt    DateTime @default(now())
}
