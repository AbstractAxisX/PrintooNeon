generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Neon sign design order — simple version (no pricing, no admin panel)
model Order {
  id           String   @id @default(cuid())
  code         String   @unique // short order code like NE-4821
  customerName String
  phone        String
  note         String?

  // neon design spec
  text         String // full text (multi-line with \n)
  fontId       String
  fontName     String
  colorId      String
  colorName    String
  mode         String   @default("solid") // solid | flow | perLetter | cycle
  widthCm      Int
  heightCm     Float? // estimated height
  backgroundId String? // wall photo or solid background id
  configJson   String? // full design config JSON (colors, timings, background, letter colors)

  imageData    String? // preview image data URL (JPEG)

  status       String   @default("new") // new | contacted | done
  createdAt    DateTime @default(now())
}
